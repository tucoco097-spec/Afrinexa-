# URL du projet Supabase et clé publishable exposées au navigateur.
# Ne jamais placer une clé secrète/service-role dans une variable VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Répéter la même URL et la même clé publishable pour le rendu côté serveur.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Mettre à true uniquement après activation et configuration du fournisseur Google dans Supabase.
VITE_GOOGLE_OAUTH_ENABLED=false
