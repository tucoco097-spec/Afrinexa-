# Supabase project URL and publishable key exposed to the browser bundle.
# Never put a secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Repeat the same project URL and publishable key for server-side rendering.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
